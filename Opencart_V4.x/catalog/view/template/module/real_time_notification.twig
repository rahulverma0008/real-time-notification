<script type="text/javascript"><!--
(function () {
    var options = {{ options|raw }};
    var seen = 0;

    // A PHP notice printed by OpenCart or another extension in front of the JSON answer must not stop the notifications:
    // the answer is read as text and the JSON is searched in it.
    function parse(text) {
        try {
            return JSON.parse(text);
        } catch (e) {
            var position = text.indexOf('{"');

            while (position !== -1) {
                try {
                    return JSON.parse(text.substring(position));
                } catch (e2) {
                    position = text.indexOf('{"', position + 1);
                }
            }
        }

        return null;
    }

    function showNotifications() {
        $.get(options.url, function (text) {
            var data = parse(String(text));

            if (!data || !data.sales) {
                return;
            }

            $.each(data.sales, function (i, v) {
                setTimeout(function () {
                    $.notify({
                        icon: v.thumb,
                        url: v.href,
                        message: v.message
                    }, {
                        placement: {from: options.placement, align: options.align},
                        type: 'notification',
                        allow_dismiss: options.allow_dismiss,
                        mouse_over: options.pause_on_hover ? 'pause' : null,
                        delay: options.delay,
                        newest_on_top: options.newest_on_top,
                        showProgressbar: options.progress_bar,
                        spacing: 20,
                        icon_type: 'image',
                        template: '<div data-notify="container" class="alert alert-{0}" role="alert">' +
                            '<div class="inner-container">' +
                            (options.allow_dismiss ? '<button type="button" aria-label="Close" class="btn-close" data-notify="dismiss"></button>' : '') +
                            '<div class="img-block"><a href="{3}" target="_blank"><img data-notify="icon" alt=""></a></div>' +
                            '<div class="content-block"><span data-notify="message">{2}</span></div>' +
                            (options.progress_bar ? '<div class="progress" data-notify="progressbar"><div class="progress-bar progress-bar-{0}" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 0%;"></div></div>' : '') +
                            '</div></div>'
                    });
                }, 2000 * i);
            });
        }, 'text');
    }

    $(document).ready(function () {
        setInterval(showNotifications, options.interval);
    });
})();
//--></script>
